{
	"name": "tanstack-table-csv-editor",
	"version": "0.1.0",
	"description": "TanStack Table ベースのスプレッドシート風 CSV エディタ (React)",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vite --config vite.demo.config.ts",
		"build": "vite build && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
		"build:demo": "vite build --config vite.demo.config.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"dependencies": {
		"@tanstack/react-table": "^9.3.1",
		"@tanstack/react-virtual": "^3.14.28",
		"encoding-japanese": "^2.5.0",
		"papaparse": "^5.7.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/encoding-japanese": "^2.4.0",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"jsdom": "^31.0.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.2"
	}
}
